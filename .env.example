# Copy to .env and adjust. .env is read by the server only and is never
# served to the browser. Never commit real keys.

# ---- Server -----------------------------------------------------------------
PORT=3000
# 127.0.0.1 = only this machine. Use 0.0.0.0 behind a reverse proxy (HTTPS).
HOST=127.0.0.1

# ---- Data mode --------------------------------------------------------------
# sample : fictional demo data (default, no network needed)
# auto   : real end-of-day data collected automatically every day (free sources)
DATA_PROVIDER=sample

# ---- auto mode: daily collection -------------------------------------------
# Runs at startup (backfill) and then daily at this IST time.
COLLECT_TIME_IST=19:15
BACKFILL_SESSIONS=300
# Pause between requests to exchange file servers (politeness).
REQUEST_DELAY_MS=2500
# upstox (default, falls back to exchange files automatically) | exchange-files
PRICE_SOURCE=upstox
# Optional: a token from YOUR Upstox account enables live last-traded prices.
# Upstox tokens expire daily. Leave empty to use end-of-day candles only.
UPSTOX_ACCESS_TOKEN=
# Set to false to run the server without collecting (e.g. a read-only replica).
AUTO_COLLECT=true
MARKET_DATA_DIR=data/market

# ---- auto mode: options (NSE F&O bhavcopy, end-of-day) --------------------
COLLECT_OPTIONS=true
# Sessions of F&O history to backfill (each file is several MB).
FO_BACKFILL_SESSIONS=20
# Full chains kept on disk for the latest N sessions.
FO_KEEP_FULL=5
# Risk-free rate assumed for implied volatility and Greeks.
OPTIONS_RISK_FREE=0.065

# ---- auto mode: free macro data (recommended) -------------------------------
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ---- auto mode: free news (RSS) ---------------------------------------------
# Comma-separated publisher RSS feeds. The NSE corporate announcements feed is
# always included. Check each publisher's terms before public use.
NEWS_RSS_FEEDS=

# ---- Advertising (Google AdSense) --------------------------------------------
# none | adsense. Ads load only after visitor consent and only in labelled slots.
AD_PROVIDER=none
ADSENSE_CLIENT=
ADSENSE_SLOT_BANNER=
ADSENSE_SLOT_INLINE=
ADSENSE_SLOT_SIDEBAR=
# Contents of /ads.txt, use \n between lines, e.g.
# google.com, pub-0000000000000000, DIRECT, f08c47fec0942fa0
ADS_TXT=

# ---- Storage / demo ---------------------------------------------------------
STORE_FILE=data/store.json
# Show the stale-data state in sample mode (for testing the UI).
SAMPLE_FORCE_STALE=false
